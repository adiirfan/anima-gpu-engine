#version 450
// Y (N x M, fp32) = X (N x K, fp16) . W^T (W: M x K, fp16), sums in fp32.
// A work group computes a BM x BN tile of Y; each thread TM x TN of it, its rows and columns strided across the tile
// (neighbouring threads read neighbouring shared-memory columns and write neighbouring outputs). X and W slices of BK
// inputs go through shared memory as [k][row]. K must be a multiple of BK and BK of 4; N and M any size.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(constant_id = 0) const uint BM = 64;
layout(constant_id = 1) const uint BN = 64;
layout(constant_id = 2) const uint BK = 16;
layout(constant_id = 3) const uint TM = 4;
layout(constant_id = 4) const uint TN = 4;
layout(local_size_x_id = 5) in;   // (BM / TM) * (BN / TN)

layout(std430, binding = 0) readonly buffer XB { f16vec4 X[]; };
layout(std430, binding = 1) readonly buffer WB { f16vec4 W[]; };
layout(std430, binding = 2) writeonly buffer YB { float Y[]; };
layout(push_constant) uniform PC { uint N, M, K; } p;

shared float16_t sx[BK * BM];
shared float16_t sw[BK * BN];

void main() {
    const uint RT = BM / TM, CT = BN / TN, NT = RT * CT;
    const uint tid = gl_LocalInvocationID.x;
    const uint ty = tid / CT, tx = tid % CT;
    const uint n0 = gl_WorkGroupID.y * BM, m0 = gl_WorkGroupID.x * BN;
    const uint K4 = p.K / 4, BK4 = BK / 4;
    float acc[TM][TN];
    for (uint i = 0; i < TM; i++) for (uint j = 0; j < TN; j++) acc[i][j] = 0.0;

    for (uint k0 = 0; k0 < p.K; k0 += BK) {
        for (uint e = tid; e < BM * BK4; e += NT) {
            const uint r = e / BK4, c = e % BK4, n = n0 + r;
            const f16vec4 v = n < p.N ? X[n * K4 + k0 / 4 + c] : f16vec4(0);
            sx[(4 * c + 0) * BM + r] = v.x; sx[(4 * c + 1) * BM + r] = v.y;
            sx[(4 * c + 2) * BM + r] = v.z; sx[(4 * c + 3) * BM + r] = v.w;
        }
        for (uint e = tid; e < BN * BK4; e += NT) {
            const uint r = e / BK4, c = e % BK4, m = m0 + r;
            const f16vec4 v = m < p.M ? W[m * K4 + k0 / 4 + c] : f16vec4(0);
            sw[(4 * c + 0) * BN + r] = v.x; sw[(4 * c + 1) * BN + r] = v.y;
            sw[(4 * c + 2) * BN + r] = v.z; sw[(4 * c + 3) * BN + r] = v.w;
        }
        barrier();
        for (uint k = 0; k < BK; k++) {
            float a[TM], b[TN];
            for (uint i = 0; i < TM; i++) a[i] = float(sx[k * BM + ty + i * RT]);
            for (uint j = 0; j < TN; j++) b[j] = float(sw[k * BN + tx + j * CT]);
            for (uint i = 0; i < TM; i++) for (uint j = 0; j < TN; j++) acc[i][j] = fma(a[i], b[j], acc[i][j]);
        }
        barrier();
    }
    for (uint i = 0; i < TM; i++) {
        const uint n = n0 + ty + i * RT;
        if (n >= p.N) continue;
        for (uint j = 0; j < TN; j++) {
            const uint m = m0 + tx + j * CT;
            if (m < p.M) Y[n * p.M + m] = acc[i][j];
        }
    }
}
