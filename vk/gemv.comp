#version 450
// y[m] = W[m] . act(x) + add[m]   (W fp16 [M][K]; act 1 = SiLU, 0 = none). One work group of 64 per output.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer WB { float16_t W[]; };
layout(std430, binding = 1) readonly buffer XB { float x[]; };
layout(std430, binding = 2) readonly buffer AB { float add[]; };
layout(std430, binding = 3) writeonly buffer YB { float y[]; };
layout(push_constant) uniform PC { uint M, K, act, hasAdd; } p;
shared float red[64];
void main() {
    const uint m = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    float s = 0.0;
    for (uint k = t; k < p.K; k += 64) {
        float a = x[k];
        if (p.act == 1u) a = a / (1.0 + exp(-a));
        s = fma(float(W[m * p.K + k]), a, s);
    }
    red[t] = s; barrier();
    for (uint w = 32; w > 0; w >>= 1) { if (t < w) red[t] += red[t + w]; barrier(); }
    if (t == 0) y[m] = red[0] + (p.hasAdd != 0u ? add[m] : 0.0);
}
