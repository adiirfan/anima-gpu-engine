#version 450
// The engine's 8-bit multiply on the matrix hardware: Y (N x M, fp32) = sum over blocks of GS inputs of
//   SX[b][n] * SW[b][m] * (X[n, block b] . W[m, block b])      (int8 X and W, exact 32-bit sums inside a block)
// The Adreno driver crashes on turning a 32-bit-integer matrix into a float one, so each block's integer tile goes to
// shared memory and the subgroup's threads scale it into their own float totals: thread t owns elements t, t + SG,
// t + 2 SG... of the row-major tile, so a thread's column (and so its SW value) never changes and the reads and the
// final writes are contiguous. Scales are block-major ([K/GS][N] and [K/GS][M]).
// A work group holds SM x SN subgroups, one TM x TN tile each. N must be a multiple of TM * SM, M of TN * SN, K of GS.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_8bit_storage : require

layout(constant_id = 0) const uint TM = 64;
layout(constant_id = 1) const uint TN = 32;
layout(constant_id = 2) const uint TK = 32;
layout(constant_id = 3) const uint SM = 1;
layout(constant_id = 4) const uint SN = 1;
layout(constant_id = 5) const uint GS = 64;
layout(constant_id = 6) const uint SG = 64;   // subgroup size; the work group is SM * SN * SG threads
layout(constant_id = 7) const uint STRIP = 0;   // 1: X and W stored as strips of TK inputs ([K/TK][rows][TK]), so a
                                                // tile's load is one contiguous run instead of rows K bytes apart
layout(local_size_x_id = 8) in;

layout(std430, binding = 0) readonly buffer XB { int8_t X[]; };
layout(std430, binding = 1) readonly buffer WB { int8_t W[]; };
layout(std430, binding = 2) readonly buffer SXB { float SX[]; };
layout(std430, binding = 3) readonly buffer SWB { float SW[]; };
layout(std430, binding = 4) writeonly buffer YB { float Y[]; };
layout(push_constant) uniform PC { uint N, M, K; } p;

const uint PER = TM * TN / SG;            // elements per thread
shared int tile[SM * SN * TM * TN];
shared float sxs[SM * SN * TM];

#define ACCI coopmat<int, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>

void main() {
    const uint sg = gl_SubgroupID, t = gl_SubgroupInvocationID;
    const uint n0 = (gl_WorkGroupID.y * SM + sg / SN) * TM, m0 = (gl_WorkGroupID.x * SN + sg % SN) * TN;
    const uint tb = sg * TM * TN, sb = sg * TM;
    const uint col = t % TN, row0 = t / TN, rstep = SG / TN;   // SG is a multiple of TN
    float acc[PER];
    for (uint i = 0; i < PER; i++) acc[i] = 0.0;
    for (uint k0 = 0, b = 0; k0 < p.K; k0 += GS, b++) {
        ACCI part = ACCI(0);
        for (uint k = k0; k < k0 + GS; k += TK) {
            coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a;
            coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> w;
            if (STRIP == 1) {
                coopMatLoad(a, X, ((k / TK) * p.N + n0) * TK, TK, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(w, W, ((k / TK) * p.M + m0) * TK, TK, gl_CooperativeMatrixLayoutColumnMajor);
            } else {
                coopMatLoad(a, X, n0 * p.K + k, p.K, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(w, W, m0 * p.K + k, p.K, gl_CooperativeMatrixLayoutColumnMajor);
            }
            part = coopMatMulAdd(a, w, part);
        }
        for (uint r = t; r < TM; r += SG) sxs[sb + r] = SX[b * p.N + n0 + r];
        coopMatStore(part, tile, tb, TN, gl_CooperativeMatrixLayoutRowMajor);
        subgroupMemoryBarrierShared();
        subgroupBarrier();
        const float sw = SW[b * p.M + m0 + col];
        for (uint i = 0; i < PER; i++)
            acc[i] = fma(float(tile[tb + t + i * SG]) * sxs[sb + row0 + i * rstep], sw, acc[i]);
        subgroupBarrier();   // the tile is overwritten by the next block
    }
    for (uint i = 0; i < PER; i++) Y[(n0 + row0 + i * rstep) * p.M + m0 + col] = acc[i];
}
