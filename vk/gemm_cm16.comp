#version 450
// Y (N x M, fp32) = X (N x K, fp16) . W^T (W: M x K, fp16) on the matrix hardware (VK_KHR_cooperative_matrix).
// A work group holds SM x SN subgroups, one TM x TN tile each (more tiles per subgroup crash the Adreno compiler). The hardware adds in fp16 (Adreno 840 has no fp16-in /
// fp32-sum mode), so every KS products of TK inputs are summed in fp16 and then added into fp32 totals.
// N must be a multiple of TM * RM, M of TN * RN, K of TK * KS (the bench picks such shapes; the engine will pad).
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(constant_id = 0) const uint TM = 64;
layout(constant_id = 1) const uint TN = 64;
layout(constant_id = 2) const uint TK = 16;
layout(constant_id = 3) const uint SM = 1;
layout(constant_id = 4) const uint SN = 1;
layout(constant_id = 5) const uint KS = 1;
layout(local_size_x_id = 6) in;   // SM * SN * subgroup size
const uint RM = 1, RN = 1;

layout(std430, binding = 0) readonly buffer XB { float16_t X[]; };
layout(std430, binding = 1) readonly buffer WB { float16_t W[]; };
layout(std430, binding = 2) writeonly buffer YB { float Y[]; };
layout(push_constant) uniform PC { uint N, M, K; } p;

void main() {
    const uint sg = gl_SubgroupID;
    const uint n0 = (gl_WorkGroupID.y * SM + sg / SN) * TM, m0 = (gl_WorkGroupID.x * SN + sg % SN) * TN;
    coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[RM][RN];
    for (uint i = 0; i < RM; i++) for (uint j = 0; j < RN; j++)
        acc[i][j] = coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0.0);
    for (uint k0 = 0; k0 < p.K; k0 += TK * KS) {
        coopmat<float16_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> part[RM][RN];
        for (uint i = 0; i < RM; i++) for (uint j = 0; j < RN; j++)
            part[i][j] = coopmat<float16_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(float16_t(0.0));
        for (uint s = 0; s < KS; s++) {
            const uint k = k0 + s * TK;
            coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a[RM];
            coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> b[RN];
            for (uint i = 0; i < RM; i++)
                coopMatLoad(a[i], X, (n0 + i * TM) * p.K + k, p.K, gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0; j < RN; j++)   // W's rows are B's columns
                coopMatLoad(b[j], W, (m0 + j * TN) * p.K + k, p.K, gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0; i < RM; i++) for (uint j = 0; j < RN; j++)
                part[i][j] = coopMatMulAdd(a[i], b[j], part[i][j]);
        }
        for (uint i = 0; i < RM; i++) for (uint j = 0; j < RN; j++)
            acc[i][j] = acc[i][j] + coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(part[i][j]);
    }
    for (uint i = 0; i < RM; i++) for (uint j = 0; j < RN; j++)
        coopMatStore(acc[i][j], Y, (n0 + i * TM) * p.M + m0 + j * TN, p.M, gl_CooperativeMatrixLayoutRowMajor);
}
