#version 450
// fp16 multiply on the matrix hardware, for attention: Y[z][n][m] (fp16) = X[z][n][:] . B[z][:][m]
//   BT 0: B given as W[m][k] (keys, row-major [M][K]);  BT 1: B given as W[k][m] (values, row-major [K][M])
// The Adreno 840 adds fp16 products in fp16 only, so each KS x 16 inputs are summed in fp16 and then added into fp32
// totals; the result is written back as fp16. One TM x TN tile per subgroup, SM x SN subgroups per work group.
// N must be a multiple of TM * SM, M of TN * SN, K of 16 * KS; strides in elements.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(constant_id = 0) const uint TM = 64;
layout(constant_id = 1) const uint TN = 64;
layout(constant_id = 2) const uint SM = 1;
layout(constant_id = 3) const uint SN = 2;
layout(constant_id = 4) const uint KS = 4;
layout(constant_id = 5) const uint BT = 0;
layout(local_size_x_id = 6) in;   // SM * SN * subgroup size
const uint TK = 16;

layout(std430, binding = 0) readonly buffer XB { float16_t X[]; };
layout(std430, binding = 1) readonly buffer WB { float16_t W[]; };
layout(std430, binding = 2) writeonly buffer YB { float16_t Y[]; };
layout(push_constant) uniform PC { uint N, M, K, ldx, ldw, ldy, bsx, bsw, bsy; } p;

#define ACCF coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>
#define ACCH coopmat<float16_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>

void main() {
    const uint sg = gl_SubgroupID, z = gl_WorkGroupID.z;
    const uint n0 = (gl_WorkGroupID.y * SM + sg / SN) * TM, m0 = (gl_WorkGroupID.x * SN + sg % SN) * TN;
    ACCF acc = ACCF(0.0);
    for (uint k0 = 0; k0 < p.K; k0 += TK * KS) {
        ACCH part = ACCH(float16_t(0.0));
        for (uint k = k0; k < k0 + TK * KS; k += TK) {
            coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a;
            coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> b;
            coopMatLoad(a, X, z * p.bsx + n0 * p.ldx + k, p.ldx, gl_CooperativeMatrixLayoutRowMajor);
            if (BT == 0) coopMatLoad(b, W, z * p.bsw + m0 * p.ldw + k, p.ldw, gl_CooperativeMatrixLayoutColumnMajor);
            else coopMatLoad(b, W, z * p.bsw + k * p.ldw + m0, p.ldw, gl_CooperativeMatrixLayoutRowMajor);
            part = coopMatMulAdd(a, b, part);
        }
        acc = acc + ACCF(part);
    }
    const ACCH out16 = ACCH(acc);
    coopMatStore(out16, Y, z * p.bsy + n0 * p.ldy + m0, p.ldy, gl_CooperativeMatrixLayoutRowMajor);
}
