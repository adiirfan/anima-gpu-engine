#version 450
// per-head block copy: D[h * dstride + i] = S[h * sstride + i] for i < n (32-bit words), h = work group y
// (Qwen-Image: a block's kept prompt keys / values into the attention inputs' rows after the picture rows)
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer SB { uint S[]; };
layout(std430, binding = 1) writeonly buffer DB { uint D[]; };
layout(push_constant) uniform PC { uint n, sstride, dstride; } p;
void main() {
    const uint i = gl_GlobalInvocationID.x, h = gl_WorkGroupID.y;
    if (i < p.n) D[h * p.dstride + i] = S[h * p.sstride + i];
}
