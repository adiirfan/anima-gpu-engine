#version 450
// Y (N x M, int32) = X (N x K, int8) . W^T (W: M x K, int8) on the matrix hardware, exact integer sums.
// A work group holds SM x SN subgroups; each subgroup computes one TM x TN tile (more than one tile per subgroup
// crashes the Adreno shader compiler). N must be a multiple of TM * SM, M of TN * SN, K of TK.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_8bit_storage : require

layout(constant_id = 0) const uint TM = 64;
layout(constant_id = 1) const uint TN = 64;
layout(constant_id = 2) const uint TK = 32;
layout(constant_id = 3) const uint SM = 1;
layout(constant_id = 4) const uint SN = 1;
layout(local_size_x_id = 5) in;   // SM * SN * subgroup size

layout(std430, binding = 0) readonly buffer XB { int8_t X[]; };
layout(std430, binding = 1) readonly buffer WB { int8_t W[]; };
layout(std430, binding = 2) writeonly buffer YB { int Y[]; };
layout(push_constant) uniform PC { uint N, M, K; } p;

void main() {
    const uint sg = gl_SubgroupID, si = sg / SN, sj = sg % SN;
    const uint n0 = (gl_WorkGroupID.y * SM + si) * TM, m0 = (gl_WorkGroupID.x * SN + sj) * TN;
    coopmat<int, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc = coopmat<int, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0);
    for (uint k = 0; k < p.K; k += TK) {
        coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a;
        coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> b;
        coopMatLoad(a, X, n0 * p.K + k, p.K, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b, W, m0 * p.K + k, p.K, gl_CooperativeMatrixLayoutColumnMajor);
        acc = coopMatMulAdd(a, b, acc);
    }
    coopMatStore(acc, Y, n0 * p.M + m0, p.M, gl_CooperativeMatrixLayoutRowMajor);
}
